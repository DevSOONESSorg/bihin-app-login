# このファイルを .env という名前でコピーして使います
# APP_NAME: 画面の左上に出る名前（体験用の名前に変えてください）
# PORT:     ブラウザで開くポート番号。完成版と同時に動かすときは 3001 などに変える
APP_NAME=備品貸出管理
PORT=3000

# セッションIDの署名に使う秘密の文字列。本番では長いランダム文字列にする
SESSION_SECRET=change-me-session-secret

# ---- 社員マスタAPI（api サービス）----
API_PORT=3001
# 認証方式: none / apikey / jwt
API_AUTH_MODE=none
API_KEY=demo-api-key-12345
API_CLIENT_ID=bihin-web
API_CLIENT_SECRET=demo-client-secret
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=10m
