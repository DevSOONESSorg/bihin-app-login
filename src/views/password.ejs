<%- include('partials/header') %>
<h1>パスワード変更</h1>
<% if (errors.length) { %>
  <ul class="errors"><% for (const e of errors) { %><li><%= e %></li><% } %></ul>
<% } %>
<form method="post" action="/password" class="form">
  <label>現在のパスワード <input type="password" name="current" autocomplete="current-password"></label>
  <label>新しいパスワード（8文字以上） <input type="password" name="next1" autocomplete="new-password"></label>
  <label>新しいパスワード（確認） <input type="password" name="next2" autocomplete="new-password"></label>
  <div class="form-actions"><button type="submit" class="primary">変更する</button></div>
</form>
<%- include('partials/footer') %>
