<%- include('../partials/header') %>
<h1>貸出登録</h1>
<p class="lead">「<%= item.name %>」を貸し出します。</p>

<% if (errors.length) { %>
  <ul class="errors">
    <% for (const e of errors) { %><li><%= e %></li><% } %>
  </ul>
<% } %>

<form method="post" action="/loans/new/<%= item.id %>" class="form">
  <label>
    借りる人 <span class="required">必須</span>
    <% if (employees.length > 0) { %>
      <%# 社員マスタAPIから取った一覧から選ぶ %>
      <select name="borrower">
        <option value="">選んでください</option>
        <% for (const e of employees) { %>
          <option value="<%= e.name %>" <%= loan.borrower === e.name ? 'selected' : '' %>><%= e.name %>（<%= e.department %>）</option>
        <% } %>
      </select>
    <% } else { %>
      <%# APIが使えないときは手入力にフォールバック %>
      <input type="text" name="borrower" value="<%= loan.borrower %>" placeholder="例：比嘉">
      <% if (apiError) { %><small class="muted">社員マスタAPIに接続できないため手入力です（<%= apiError %>）</small><% } %>
    <% } %>
  </label>
  <label>
    貸出日
    <input type="date" name="lent_on" value="<%= loan.lent_on %>">
  </label>
  <label>
    返却期限
    <input type="date" name="due_on" value="<%= loan.due_on %>">
  </label>
  <div class="form-actions">
    <button type="submit" class="primary">貸し出す</button>
    <a href="/items/<%= item.id %>">キャンセル</a>
  </div>
</form>
<%- include('../partials/footer') %>
